# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Confirm this model is available on your Google AI Studio project's free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgresql://user:password@localhost:5432/vertix
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
BUSINESS_NOTIFICATION_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vertix Commerce <notifications@vertixcommerce.com>
RESEND_FROM_EMAIL_ADDRESS=notifications@vertixcommerce.com

# Public website images only. SQL above stores CMS, leads and conversations.
# Leave S3_BUCKET empty for local development storage in ./media.
# For Supabase copy endpoint/region/access keys from Storage > S3 configuration.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Production shared protection. Keep both Redis values server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable ONLY behind a proxy that replaces X-Forwarded-For with a trusted client IP.
TRUST_PROXY_HEADERS=false
# At least 32 random characters. Scheduler sends this as a Bearer token.
CRON_SECRET=

# Calendly Free: server-read setup. Only the public event URL reaches visitors.
# Create the event in Calendly, then paste its public event URL.
# Use this host email in Calendly itself; this variable does NOT configure recipients.
# Emails and join links are sent by Calendly after a confirmed booking.
CALENDLY_EVENT_URL=
CALENDLY_HOST_EMAIL=

# Public configuration (safe to expose)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy fallback. Prefer CALENDLY_EVENT_URL or Admin > Contact & booking.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Example format: +92XXXXXXXXXX. Also editable in Admin > Website > Contact & booking.
